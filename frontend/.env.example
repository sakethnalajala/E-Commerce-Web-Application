# FRONTEND ENVIRONMENT — copy to .env and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secrets here: everything in this file ships to the client bundle.

# Base URL of the backend API, including the version prefix.
# Local:      http://localhost:5000/api/v1
# Production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Target for the Vite dev-server proxy (development only).
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Shown in the navbar / page titles.
VITE_APP_NAME=ShopSphere

# --- Demo logins --------------------------------------------------------------
# Locally: put these in frontend/.env.development (read by `npm run dev` only).
#   VITE_ENABLE_DEMO_LOGIN=true
#   VITE_DEMO_CUSTOMER_EMAIL=
#   VITE_DEMO_CUSTOMER_PASSWORD=
#   VITE_DEMO_ADMIN_EMAIL=
#   VITE_DEMO_ADMIN_PASSWORD=
#
# On a deployed build (Vercel) you may enable the CUSTOMER demo only, by setting
# VITE_ENABLE_DEMO_LOGIN=true plus VITE_DEMO_CUSTOMER_EMAIL / _PASSWORD. It signs
# in through the normal /auth/login endpoint with a seeded showcase account.
# Anything prefixed VITE_ is readable by anyone who opens the site, so use a
# throwaway account with no real data — never a personal password.
#
# The ADMIN demo (VITE_DEMO_ADMIN_*) is ignored in production builds by design:
# administrator credentials are never shipped to a public site.
