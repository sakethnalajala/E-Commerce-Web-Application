##############################################################################
# BACKEND ENVIRONMENT — copy to .env and fill in real values.
# .env is git-ignored. Never commit real secrets.
# On Render, set these under Dashboard -> Service -> Environment.
##############################################################################

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- MongoDB Atlas -----------------------------------------------------------
# Atlas -> Database -> <cluster> -> Connect -> Drivers -> copy the string.
# URL-encode special characters in the password (@ -> %40, # -> %23, ...).
# Add 0.0.0.0/0 to Atlas Network Access so Render can connect.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# The database the app uses on that cluster. Every read and write is scoped to
# this name regardless of any path in MONGODB_URI, so other databases on the
# same cluster are never touched.
MONGODB_DB_NAME=ecommerce_db

# Development-only escape hatch: starts a throwaway in-memory MongoDB and seeds
# it, so the stack can be demoed without Atlas credentials. Must stay false for
# the real application; it is rejected outright when NODE_ENV=production.
USE_MEMORY_DB=false

# --- Authentication ----------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
RESET_TOKEN_EXPIRES_MINUTES=15

# --- Cloudinary (product image storage) --------------------------------------
# Cloudinary Dashboard -> Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=ecommerce/products

# --- URLs / CORS -------------------------------------------------------------
# CLIENT_URL is the only origin allowed in production (plus ADDITIONAL_CORS_ORIGINS).
# It must be the EXACT deployed frontend origin — scheme + host, no trailing slash
# and no path, e.g. https://your-app.vercel.app. A mismatch makes the browser
# report "cannot reach the server"; the rejected origin is logged on startup and
# the active allow-list is visible at GET /api/v1/health (corsAllowedOrigins).
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Comma separated. Use the literal "*.vercel.app" entry to also allow Vercel previews.
ADDITIONAL_CORS_ORIGINS=

# --- Email (password reset) --------------------------------------------------
# Optional. Without SMTP, reset links are logged to the server console in
# development instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopSphere <no-reply@example.com>

# --- Rate limiting -----------------------------------------------------------
# Per-IP limits per window. Leave RATE_LIMIT_MAX / AUTH_RATE_LIMIT_MAX unset to
# get the built-in defaults: 300 / 30 in production, 3000 / 100 in development
# (dev tooling such as React StrictMode doubles every request). AUTH limits only
# count FAILED login/register attempts. /health and CORS preflights are exempt.
RATE_LIMIT_WINDOW_MINUTES=15
#RATE_LIMIT_MAX=300
#AUTH_RATE_LIMIT_MAX=30

# --- Order pricing rules (server-side source of truth) -----------------------
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=49
TAX_RATE=0.05

# --- Seed script credentials -------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-admin-password
SEED_CUSTOMER_PASSWORD=your-customer-password

# --- Social sign-in (optional) -------------------------------------------------
# Google: create an OAuth 2.0 "Web application" client in Google Cloud Console.
#   Authorised JavaScript origins: http://localhost:5173 (dev) and your site URL.
#   The client ID is public (sent to the browser); the secret must stay here and
#   is required for the popup code flow the storefront uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: create an App ID + a Services ID with "Sign in with Apple" enabled and
#   register your site domain and Return URL (Apple requires https; localhost is
#   not accepted, so test on a deployed https origin). APPLE_CLIENT_ID is the
#   Services ID (e.g. com.yourcompany.shopsphere.web).
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
