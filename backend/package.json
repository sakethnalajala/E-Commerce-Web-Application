{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-style E-Commerce REST API — Node.js, Express, MongoDB Atlas, Mongoose, JWT, Cloudinary",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "cross-env USE_MEMORY_DB=true nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:destroy": "node src/seed/seed.js --destroy",
    "seed:images": "node src/seed/reimageProducts.js",
    "seed:catalogue": "node src/seed/seedCatalogue.js"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "cloudinary"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9"
  }
}
